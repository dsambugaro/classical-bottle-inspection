# Copy this file to .env and set the path of the Kaggle dataset
# "Water Bottle Defect-Level Detection" (the folder with images/, labels/ and data.yaml):
# https://www.kaggle.com/datasets/jihadakbr/water-bottle-defect-level-detection-dataset/
#
# Read by the Makefile and by every Python script (bottle_inspection/env.py).
# A relative path is relative to this code/ folder. Default: ../archive
BOTTLE_DATA=../archive
